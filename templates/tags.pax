---
layout: layouts/base
---
<div class="card p-3">
<div class="row  p-3">
    {% for tag, posts in tags.items() %}
    <div class="col-lg-4 col-md-6 mt-1 mb-2">
        <div class="blog-card h-100 card p-3">
            <div class="d-flex justify-content-between align-items-start">
                <h5 class="fw-bold mb-2">
                    <a href="{{ tag }}" class="text-decoration-none text-dark">
                        #{{ tag }}
                    </a>
                </h5>
                </div>
            <p class="text-secondary small">
                {{ posts|length }} post{% if posts|length > 1 %}s{% endif %}
            </p>
            <div class="mt-2">
                {% for post in posts[:3] %}
                <a href="{{ post.url }}" class="text-secondary small d-block">
                    {{ post.metadata.title }}
                </a>
                {% endfor %}
                {% if posts|length > 3 %}
                <a href="{{ tag }}" class="text-primary small">+{{ posts|length - 3 }} more</a>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>
</div>