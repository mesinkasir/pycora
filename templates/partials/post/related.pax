{% if related_posts %}
<section class="card p-3">
    <div class="row g-4">
    <h2 class="col-lg-12 text-center p-3 fw-bold mb-2">Related Posts</h2>
        {% for related in related_posts[:3] %} 
        <div class="col-md-4">
            <div class="blog-card h-100" style="padding: 1.5rem;">
                {% if related.metadata.image %}
                <a href="{{ related.url }}">
                    <img class="img-fluid rounded-3 mt2 mb-2 shadow-sm" alt="{{ related.metadata.title }}" 
                         width="100%" height="100%" loading="lazy"
                         src="{{ related.metadata.image }}"/>
                </a>
                {% endif %}
                <h3><a href="{{ related.url }}" class="post-title" style="font-size: 1.1rem;">
                    {{ related.metadata.title }}
                </a></h3>
                <p>
                    <span class="text-muted"><small>
                    {{ related.date.strftime('%b %d, %Y') }}
                    </small>
                    </span>
                </p>
            </div>
        </div>
{% endfor %}
</div>
</section>
{% endif %}