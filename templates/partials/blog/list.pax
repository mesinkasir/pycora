<div class="row">
{% for post in posts %}
<div class="col-lg-4 col-md-6 col-12 p-2">
<div class="card p-2">
{% if post.image %}
<a href="{{post.url}}"><img class="img-fluid shadow" 
  width="100%" height="100%"
  alt="{{ post.title }}"
    src="{{ post.image }}" /></a>
{% endif %} 
    <div class="p-3">
        <h3><a href="{{post.url}}" class="text-dark">{{ post.title }}</a></h3>
        <p>{{ post.description }}</p>
    </div>
    <div class="card-footer text-center">{{ post.date.strftime('%B %d, %Y') }}</div>
</div>
</div>
{% endfor %}
</div>