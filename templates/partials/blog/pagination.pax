{% if total_pages > 1 %}
<div class="card p-3 mt-4">
<ul class="pagination justify-content-center mb-0">
  {% if current_page > 1 %}
  <li class="page-item">
    <a class="page-link" href="{% if current_page == 2 %}{{ pagination.first_url }}{% else %}/{{ collection_name }}/page/{{ current_page - 1 }}/{% endif %}">
      Previous
    </a>
  </li>
  {% else %}
  <li class="page-item disabled">
    <a class="page-link" href="#" tabindex="-1">Previous</a>
  </li>
  {% endif %}
  {% for page_num in range(1, total_pages + 1) %}
  <li class="page-item {% if page_num == current_page %}active{% endif %}">
    <a class="page-link" href="{% if page_num == 1 %}{{ pagination.first_url }}{% else %}/{{ collection_name }}/page/{{ page_num }}/{% endif %}">
      {{ page_num }}
    </a>
  </li>
  {% endfor %}
  {% if current_page < total_pages %}
  <li class="page-item">
    <a class="page-link" href="/{{ collection_name }}/page/{{ current_page + 1 }}/">
      Next
    </a>
  </li>
  {% else %}
  <li class="page-item disabled">
    <a class="page-link" href="#">Next</a>
  </li>
  {% endif %}
</ul>
</div>
{% endif %}